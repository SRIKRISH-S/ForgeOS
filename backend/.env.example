# ==============================================
# ForgeOS Environment Configuration
# ==============================================

# Anthropic Claude API Key
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Locus API Keys
# Get from: https://locusfinance.io/developers
LOCUS_API_KEY=your_locus_api_key_here
LOCUS_WEBHOOK_SECRET=your_locus_webhook_secret_here
LOCUS_WALLET_ID=your_locus_wallet_id_here

# Server Config
PORT=3001
FRONTEND_URL=http://localhost:5173

# Demo Mode (set to true if no Locus keys yet - uses simulated payments)
DEMO_MODE=true
